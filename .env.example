OPENAI_API_KEY=
MAILTRAP_API_TOKEN=
# Preferred (matches mailtrap-mcp). MAILTRAP_FROM_EMAIL is also accepted.
DEFAULT_FROM_EMAIL=hello@your-verified-domain.com
# Optional: allow sending to your own address during live testing
ALLOWED_RECIPIENT_EMAIL=you@yourdomain.com
# Optional: Mailtrap account ID (passed through to the SDK client)
# MAILTRAP_ACCOUNT_ID=
